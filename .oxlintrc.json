{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": [
    "legion-toolkit/eslint-plugin"
  ],
  "rules": {
    "legion/no-narrative-comments": [
      "error",
      {}
    ],
    "legion/scoped-disables": [
      "error",
      {
        "locked": [
          "no-narrative-comments",
          "scoped-disables",
          "no-disables",
          "no-react-fc",
          "no-enum",
          "no-function-keyword",
          "no-client-globals-in-state-init",
          "no-use-client-in-page",
          "guarded-context-hook",
          "presentational-components",
          "no-literal-conditions-in-jsx",
          "no-admin-client-in-browser",
          "no-ternary",
          "no-unneeded-ternary",
          "unicorn/prefer-logical-operator-over-ternary",
          "no-explicit-any",
          "max-lines"
        ]
      }
    ],
    "legion/no-disables": "error",
    "legion/no-react-fc": "error",
    "legion/no-enum": "error",
    "legion/no-function-keyword": "error",
    "legion/no-client-globals-in-state-init": "error",
    "legion/no-use-client-in-page": "error",
    "legion/guarded-context-hook": "error",
    "legion/presentational-components": [
      "error",
      {
        "reactCompiler": false
      }
    ],
    "legion/no-literal-conditions-in-jsx": "error",
    "legion/no-admin-client-in-browser": [
      "error",
      {}
    ],
    "legion/no-manual-memo": "off",
    "legion/button-has-type": "warn",
    "legion/no-target-blank-without-rel": "warn",
    "legion/anchor-is-not-a-button": "warn",
    "legion/img-has-alt": "warn",
    "legion/no-dangerous-html": "warn",
    "legion/no-array-index-key": "warn",
    "legion/no-hardcoded-hex": "warn",
    "legion/no-rn-button": "off",
    "legion/touchable-has-accessibility-label": "off",
    "legion/controlled-text-input": "off",
    "legion/no-web-dialogs": "off",
    "no-ternary": "error",
    "no-unneeded-ternary": [
      "error",
      {
        "defaultAssignment": false
      }
    ],
    "unicorn/prefer-logical-operator-over-ternary": "error",
    "typescript/no-explicit-any": "error",
    "react/button-has-type": "error"
  },
  "overrides": [
    {
      "files": [
        "**/*.tsx"
      ],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 180,
            "skipBlankLines": true,
            "skipComments": true
          }
        ]
      }
    },
    {
      "files": [
        "**/*.test.*",
        "**/*.spec.*",
        "**/__tests__/**"
      ],
      "rules": {
        "max-lines": "off",
        "legion/no-hardcoded-hex": "off"
      }
    },
    {
      "files": [
        "lib/supabase/**",
        "**/*.d.ts"
      ],
      "rules": {
        "typescript/no-explicit-any": "off"
      }
    }
  ],
  "plugins": [
    "react",
    "unicorn",
    "oxc",
    "typescript"
  ],
  "ignorePatterns": [
    "node_modules/**",
    ".next/**",
    "out/**",
    "build/**",
    "coverage/**",
    "public/**",
    "next-env.d.ts",
    "**/*.d.ts"
  ]
}
